rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function cust(uid)      { return get(/databases/$(db)/documents/customers/$(uid)).data; }
    function custAfter(uid) { return getAfter(/databases/$(db)/documents/customers/$(uid)).data; }
    function wheel() {
      let p = /databases/$(db)/documents/settings/config;
      return exists(p) && ('wheel' in get(p).data)
        ? get(p).data.wheel
        : ['Free Cappuccino','Free Brownie','10% Off','Free Cookie','Free Masala Chai','Try Again'];
    }

    match /menu/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // Orders: customers may only create a well-formed "Placed" order for themselves,
    // at most one per 10 s. Only staff change status; nobody can delete.
    match /orders/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['no','uid','phone','name','table','items','total','st','t'])
        && request.resource.data.keys().hasAll(['no','uid','phone','name','table','items','total','st','t'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.st == 0
        && request.resource.data.t == request.time
        && request.resource.data.name == cust(request.auth.uid).name
        && request.resource.data.phone == cust(request.auth.uid).phone
        && request.resource.data.no is string && request.resource.data.no.matches('[0-9]{1,8}')
        && request.resource.data.table is string && request.resource.data.table.size() <= 10
        && request.resource.data.total is number
        && request.resource.data.total > 0 && request.resource.data.total <= 20000
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 20
        && custAfter(request.auth.uid).lastOrder == request.time;
      allow read: if isAdmin() || resource.data.uid == request.auth.uid;
      allow update: if isAdmin() && resource.data.st != 3            // served orders are locked
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])
        && request.resource.data.st is int
        && request.resource.data.st >= 0 && request.resource.data.st <= 3;
      allow delete: if false;
    }

    // Customers: profile is immutable after signup. paid/rewards are staff-controlled
    // (awarded when an order is served). A customer can only (a) stamp lastOrder
    // (rate limit) or (b) spend exactly one reward together with a matching win.
    match /customers/{uid} {
      allow get:  if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','paid','rewards','spins','joined'])
        && request.resource.data.keys().hasAll(['name','phone','paid','rewards','spins','joined'])
        && request.resource.data.paid == 0 && request.resource.data.rewards == 0 && request.resource.data.spins == 0
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.matches('[0-9]{10}')
        && request.resource.data.joined == request.time;
      allow update: if signedIn() && request.auth.uid == uid && (
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastOrder'])
          && request.resource.data.lastOrder == request.time
          && (!('lastOrder' in resource.data) || request.time > resource.data.lastOrder + duration.value(10, 's')) )
        ||
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewards','spins'])
          && request.resource.data.rewards == resource.data.rewards - 1
          && request.resource.data.rewards >= 0
          && request.resource.data.spins == resource.data.get('spins', 0) + 1 ) );
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid','rewards'])
        && request.resource.data.paid is number && request.resource.data.paid >= 0
        && request.resource.data.rewards is number && request.resource.data.rewards >= 0;
    }

    // Wins: one per spent reward. The doc id is uid_<spin number>, and the same
    // transaction must decrement rewards by exactly 1 and bump spins by 1.
    match /wins/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','name','phone','prize','status','t'])
        && request.resource.data.keys().hasAll(['uid','name','phone','prize','status','t'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.t == request.time
        && request.resource.data.name == cust(request.auth.uid).name
        && request.resource.data.phone == cust(request.auth.uid).phone
        && request.resource.data.prize is string && request.resource.data.prize in wheel()
        && custAfter(request.auth.uid).rewards == cust(request.auth.uid).rewards - 1
        && custAfter(request.auth.uid).spins == cust(request.auth.uid).get('spins', 0) + 1
        && id == request.auth.uid + '_' + string(custAfter(request.auth.uid).spins);
      allow read:   if isAdmin() || resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending','claimed'];
      allow delete: if false;
    }

    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; }
  }
}
